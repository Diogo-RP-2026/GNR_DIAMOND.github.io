# Configurar só em Supabase > Edge Functions > Secrets (nunca em config.js).
# OTP_SECRET: gerar pelo menos 32 bytes aleatórios, guardar fora do repositório.
OTP_SECRET=
# Gmail: definir OTP_EMAIL_PROVIDER=gmail e preencher as duas variáveis seguintes.
# Usar palavra-passe de aplicação Google, nunca a palavra-passe normal da conta.
# O endereço escolhido será apresentado como remetente aos destinatários.
OTP_EMAIL_PROVIDER=resend
OTP_GMAIL_USER=
OTP_GMAIL_APP_PASSWORD=
# Chave do Resend com permissão de envio e remetente num domínio verificado.
# Só necessárias quando OTP_EMAIL_PROVIDER=resend (valor predefinido).
RESEND_API_KEY=
OTP_FROM_EMAIL=
# Origin sem caminho/barra final; separar por vírgulas se houver mais.
OTP_ALLOWED_ORIGINS=https://diogo-rp-2026.github.io
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY são injetados pelo Supabase.
